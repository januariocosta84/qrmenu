msgstr "Hili meza másimu 200, ho remata ≥ hahú."

msgid "Staff member"
msgstr "Funsionáriu"

msgid "Role"
msgstr "Knaar"

#, python-format
msgid "Branch names must use your brand name, e.g. “%(example)s”."
msgstr "Naran filial tenke uza ita-nia naran marka, ez.: “%(example)s”."

msgid "Branch name"
msgstr "Naran filiál"

msgid ""
"Must use your brand name, e.g. Kafe Atauro – Comoro. Customers see this name."
msgstr ""
"Tenke uza ita-nia naran marka, ez.: Kafe Atauro – Comoro. Kliente sira haree "
"naran ne'e."

msgid "Branch address"
msgstr "Enderesu filial"

msgid "Branch phone number"
msgstr "Númeru telefone filial"

msgid "Storefront photo"
msgstr "Foto fachada"

msgid "A photo of the branch from outside, showing the brand name."
msgstr "Foto filial husi liur, ne'ebé hatudu naran marka."

msgid "Business registration number"
msgstr "Númeru rejistu negósiu"

msgid ""
"All branches must belong to the same business registration as the main "
"branch."
msgstr ""
"Filial hotu tenke pertense ba rejistu negósiu hanesan ho filial prinsipál."

msgid "Owner name"
msgstr "Naran na'in"

msgid "Copy from"
msgstr "Kopia husi"

msgid "Start empty"
msgstr "Hahú mamuk"

msgid "Copy the menu (categories, dishes, photos, add-ons)"
msgstr "Kopia menu (kategoria, hahán, foto, estra)"

msgid "Copy settings (currency, service charge, VAT, receipts, logo)"
msgstr "Kopia konfigurasaun (moeda, taxa servisu, IVA, resibu, logotipu)"

msgid "Username"
msgstr "Naran uzuáriu"

msgid "Share it with the staff member; they can change it later."
msgstr "Fó ida ne'e ba funsionáriu; nia bele troka depois."

msgid "An account with this email already exists."
msgstr "Konta ho email ne'e iha ona."

msgid "This username is already taken."
msgstr "Naran uzuáriu ne'e iha ema uza ona."

msgid "Method"
msgstr "Métodu"

msgid "Amount"
msgstr "Montante"

msgid "Reference"
msgstr "Referénsia"

msgid "Receipt / transfer reference"
msgstr "Referénsia resibu / transferénsia"

msgid "Order # / name"
msgstr "Nú. pedidu / naran"

msgid "Add your logo, address and opening hours"
msgstr "Aumenta ita-nia logotipu, enderesu no oras loke"

msgid "Create menu categories (e.g. Rice, Drinks)"
msgstr "Kria kategoria menu (ez. Etu, Hemu)"

msgid "Add your dishes with photos and prices"
msgstr "Aumenta hahán sira ho foto no folin"

msgid "Create your tables"
msgstr "Kria ita-nia meza sira"

msgid "Print the QR codes and place one on each table"
msgstr "Imprime kódigu QR no tau ida iha meza ida-idak"

msgid "Add kitchen and waiter accounts"
msgstr "Aumenta konta ba kozinha no serbidór sira"

#, python-format
msgid "Order #%(number)s → %(status)s."
msgstr "Pedidu #%(number)s → %(status)s."

#, python-format
msgid "Payment recorded. Order #%(number)s is now %(status)s."
msgstr "Pagamentu rejista ona. Pedidu #%(number)s agora: %(status)s."

msgid "Accept"
msgstr "Simu"

msgid "Start preparing"
msgstr "Hahú prepara"

msgid "Mark ready"
msgstr "Marka prontu"

msgid "Complete"
msgstr "Remata"

msgid "Cancel order"
msgstr "Kansela pedidu"

msgid "Enter the cash received as a number, e.g. 20 or 20.00."
msgstr "Hakerek osan ne'ebé simu ho númeru, ez. 20 ka 20.00."

msgid "Enter a valid cash amount."
msgstr "Hakerek montante osan ne'ebé válidu."

#, python-format
msgid "GIVE CHANGE: %(change)s  (received %(received)s, total %(total)s)"
msgstr "FÓ TROKU: %(change)s  (simu %(received)s, totál %(total)s)"

#, python-format
msgid "Exact amount received: %(total)s. No change."
msgstr "Simu osan loos: %(total)s. La iha troku."

#, python-format
msgid "Receipt not printed: %(reason)s"
msgstr "Resibu la imprime: %(reason)s"

msgid "Cash drawer opened."
msgstr "Gaveta osan loke ona."

#, python-format
msgid "Payment saved, but the cash drawer did not open: %(reason)s"
msgstr "Pagamentu rai ona, maibé gaveta osan la loke: %(reason)s"

msgid "Cash payment"
msgstr "Pagamentu osan-kontadu"

msgid "No sale"
msgstr "La fa'an"

msgid "Printer test"
msgstr "Teste imprimidora"

msgid ""
"Printing a test slip. If the cash drawer is set up in the printer driver, it "
"opens too."
msgstr ""
"Imprime hela slip teste. Se gaveta osan konfigura ona iha driver "
"imprimidora, nia mós sei loke."

#, python-format
msgid "Cash register opened with %(amount)s change."
msgstr "Kaixa loke ona ho troku %(amount)s."

msgid "Cash movement recorded."
msgstr "Movimentu osan rejista ona."

#, python-format
msgid "Order #%(number)s marked as paid."
msgstr "Pedidu #%(number)s marka ona katak selu ona."

msgid "Your role cannot manage tables."
msgstr "Ita-nia knaar la bele jere meza."

#, python-format
msgid "Limit reached: a restaurant can have up to %(n)s tables on your plan."
msgstr "To'o ona limite: ita-nia planu permite meza to'o %(n)s."

#, python-format
msgid "Created %(n)s table."
msgid_plural "Created %(n)s tables."
msgstr[0] "Kria ona meza %(n)s."
msgstr[1] "Kria ona meza %(n)s."

#, python-format
msgid "Limit reached: your plan allows %(n)s tables."
msgstr "To'o ona limite: ita-nia planu permite meza %(n)s."

#, python-format
msgid "Table %(number)s created."
msgstr "Meza %(number)s kria ona."

#, python-format
msgid "Guest %(n)s"
msgstr "Bainaka %(n)s"

#, python-format
msgid "Marked as paid: %(numbers)s."
msgstr "Marka ona katak selu ona: %(numbers)s."

msgid "This guest has nothing left to pay."
msgstr "Bainaka ne'e la iha buat ida atu selu tan."

msgid "There were no unpaid orders at this table."
msgstr "La iha pedidu ne'ebé seidauk selu iha meza ne'e."

#, python-format
msgid "Table %(number)s is now free."
msgstr "Meza %(number)s agora livre."

#, python-format
msgid ""
"Table %(number)s is now free. Customers must scan the QR code again to order."
msgstr ""
"Meza %(number)s agora livre. Kliente sira tenke scan fali kódigu QR atu pede."

msgid "Table updated. Reprint its QR code if you changed the number."
msgstr "Meza atualiza ona. Imprime fali kódigu QR se ita troka númeru."

#, python-format
msgid "Edit table %(number)s"
msgstr "Edita meza %(number)s"

#, python-format
msgid "Table %(number)s deleted."
msgstr "Meza %(number)s hamoos ona."

#, python-format
msgid ""
"New QR code generated for table %(number)s. Old printed codes no longer work "
"— print the new one."
msgstr ""
"Kódigu QR foun kria ona ba meza %(number)s. Kódigu tuan sira la funsiona ona "
"— imprime ida foun."

msgid "Category saved."
msgstr "Kategoria rai ona."

#, python-format
msgid "Edit category: %(name)s"
msgstr "Edita kategoria: %(name)s"

msgid "New category"
msgstr "Kategoria foun"

msgid "Category deleted."
msgstr "Kategoria hamoos ona."

msgid "Move or delete the dishes in this category first."
msgstr "Muda ka hamoos uluk hahán sira iha kategoria ne'e."

msgid "Create a category first."
msgstr "Kria uluk kategoria ida."

#, python-format
msgid "Limit reached: your plan allows %(n)s dishes."
msgstr "To'o ona limite: ita-nia planu permite hahán %(n)s."

#, python-format
msgid "“%(name)s” saved."
msgstr "“%(name)s” rai ona."

#, python-format
msgid "“%(name)s” deleted."
msgstr "“%(name)s” hamoos ona."

msgid "Restaurant settings saved."
msgstr "Konfigurasaun restaurante rai ona."

msgid "Profile"
msgstr "Perfíl"

msgid "How your restaurant appears to customers."
msgstr "Oinsá ita-nia restaurante mosu ba kliente sira."

msgid "Branding"
msgstr "Imajen"

msgid "Shown at the top of your menu. JPEG, PNG or WebP up to 5 MB."
msgstr "Mosu iha menu nia leten. JPEG, PNG ka WebP to'o 5 MB."

msgid "Ordering & money"
msgstr "Pedidu no osan"

msgid "Pause ordering at any time; prices are shown in this currency."
msgstr "Bele para pedidu iha tempu ruma; folin sira mosu iha moeda ne'e."

msgid "Tax (VAT)"
msgstr "Impostu (IVA)"

msgid ""
"Off by default. Switch it on only if your restaurant must charge VAT. Past "
"orders keep the VAT they were placed with."
msgstr ""
"Dezativa hela. Ativa de'it se ita-nia restaurante tenke kobra IVA. Pedidu "
"uluk sira rai nafatin IVA ne'ebé sira iha bainhira pede."

msgid "Customer menu language"
msgstr "Lian menu ba kliente"

msgid ""
"Customers can switch language on the menu; untranslated text falls back to "
"English."
msgstr ""
"Kliente sira bele troka lian iha menu; testu ne'ebé seidauk tradús sei mosu "
"iha Inglés."

