#, python-format
msgid "Cannot change order from %(from)s to %(to)s."
msgstr "Labele troka pedidu husi %(from)s ba %(to)s."

msgid ""
"Can't find this printer address. Use the printer's IP, e.g. 192.168.1.50."
msgstr ""
"La hetan enderesu imprimidora ne'e. Uza IP imprimidora nian, ez. "
"192.168.1.50."

msgid ""
"The printer must be on the local network (e.g. 192.168.x.x or 10.x.x.x)."
msgstr "Imprimidora tenke iha rede lokál (ez. 192.168.x.x ka 10.x.x.x)."

msgid "Cash drawer is not set up."
msgstr "Gaveta osan seidauk konfigura."

#, python-format
msgid "Printer at %(target)s did not respond. Is it switched on and connected?"
msgstr "Imprimidora iha %(target)s la responde. Nia moris no liga ona?"

#, python-format
msgid "Could not reach the printer at %(target)s (%(error)s)."
msgstr "La konsege liga ba imprimidora iha %(target)s (%(error)s)."

