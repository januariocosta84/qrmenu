#: apps/accounts/forms.py:16
msgid ""
"I confirm I own or manage this restaurant, and I accept the terms of service."
msgstr ""
"Ha'u konfirma ha'u na'in ka jere restaurante ne'e, no ha'u aseita termu "
"servisu."

#: apps/accounts/forms.py:23 apps/accounts/views.py:124
msgid ""
"An account with this email already exists. Try logging in or resetting your "
"password."
msgstr "Konta ho email ne'e iha ona. Koko tama ka troka palavra-pase."

#: apps/accounts/forms.py:29
msgid "Enter the restaurant's name."
msgstr "Hakerek naran restaurante."

#: apps/accounts/forms.py:35
msgid "Sign-up failed. Please try again."
msgstr "Rejistu la susesu. Favór koko fali."

#: apps/accounts/signup.py:160
#, python-format
msgid "%(code)s is your %(platform)s verification code"
msgstr "%(code)s mak ita-nia kódigu verifikasaun %(platform)s"

#: apps/accounts/views.py:49
msgid "Too many failed login attempts. Please try again in 15 minutes."
msgstr "Koko tama sala barak liu. Favór koko fali iha minutu 15 nia laran."

#: apps/accounts/views.py:76
msgid "Too many sign-ups from your network. Please try again in an hour."
msgstr ""
"Rejistu barak liu husi ita-nia rede. Favór koko fali iha oras ida nia laran."

#: apps/accounts/views.py:80
msgid "Too many codes were sent to this email. Please try again in an hour."
msgstr "Kódigu barak liu ona haruka ba email ne'e. Favor koko fali oras ida tan."

#: apps/accounts/views.py:88
msgid "We couldn't send an email to this address. Please check it and try again."
msgstr "Ami la konsege haruka email ba enderesu ne'e. Favor verifika no koko fali."

#: apps/accounts/views.py:102
msgid "Please fill in the registration form first."
msgstr "Favor prenxe uluk formuláriu rejistu."

#: apps/accounts/views.py:108
msgid "No more codes can be sent for this registration. Please start again."
msgstr "Labele haruka tan kódigu ba rejistu ne'e. Favor komesa fali."

#: apps/accounts/views.py:110
#, python-format
msgid "Please wait %(s)s seconds before asking for a new code."
msgstr "Favor hein segundu %(s)s molok husu kódigu foun."

#: apps/accounts/views.py:114
#, python-format
msgid "We sent a new code to %(email)s."
msgstr "Ami haruka ona kódigu foun ba %(email)s."

#: apps/accounts/views.py:118 apps/accounts/views.py:176
msgid "We couldn't send the email right now. Please try again later."
msgstr "Ami la konsege haruka email agora. Favór koko fali depois."

#: apps/accounts/views.py:130
msgid "Email confirmed. Welcome! Your restaurant is ready: add your menu and tables."
msgstr "Email konfirma ona. Benvindu! Ita-nia restaurante prontu ona: aumenta ita-nia menu no meza."

#: apps/accounts/views.py:132 apps/accounts/views.py:156
msgid ""
"Email confirmed. Your restaurant is waiting for approval by the platform "
"team."
msgstr ""
"Email konfirmadu ona. Ita-nia restaurante hein hela aprovasaun husi ekipa "
"plataforma."

#: apps/accounts/views.py:136
msgid "Too many wrong codes. Please fill in the form again to get a new code."
msgstr "Kódigu sala barak liu. Favor prenxe fali formuláriu atu simu kódigu foun."

#: apps/accounts/views.py:138
msgid "This code has expired. Ask for a new code below."
msgstr "Kódigu ne'e la válidu ona. Husu kódigu foun iha kraik."

#: apps/accounts/views.py:139
msgid "That code is not right. Check the email and try again."
msgstr "Kódigu ne'e la loos. Haree fali email no koko fali."

#: apps/accounts/views.py:150
msgid ""
"This confirmation link is invalid or has expired. Log in and request a new "
"one."
msgstr ""
"Link konfirmasaun ne'e la válidu ka liu ona prazu. Tama no husu link foun."

#: apps/accounts/views.py:154
msgid ""
"Email confirmed — your restaurant is now live! Customers can scan your QR "
"codes."
msgstr ""
"Email konfirmadu ona — ita-nia restaurante ativu ona! Kliente sira bele scan "
"ita-nia kódigu QR."

#: apps/accounts/views.py:158
msgid "Email confirmed."
msgstr "Email konfirmadu ona."

#: apps/accounts/views.py:167
msgid "Your email is already confirmed."
msgstr "Ita-nia email konfirmadu tiha ona."

#: apps/accounts/views.py:169
msgid "Please wait a while before requesting another email."
msgstr "Favór hein uitoan molok husu email seluk."

#: apps/accounts/views.py:173
#, python-format
msgid "Confirmation email sent to %(email)s."
msgstr "Email konfirmasaun haruka ona ba %(email)s."

