msgid "Restaurant name"
msgstr "Naran restaurante"

msgid "Your name"
msgstr "Ita-nia naran"

msgid "Email"
msgstr "Email"

msgid "You'll sign in with this email. We'll send a confirmation link."
msgstr "Ita sei tama ho email ne'e. Ami sei haruka link ida atu konfirma."

msgid "Phone (optional)"
msgstr "Telefone (opsionál)"

msgid "Password"
msgstr "Liafuan-pase"

msgid ""
"I confirm I own or manage this restaurant, and I accept the terms of service."
msgstr ""
"Ha'u konfirma ha'u na'in ka jere restaurante ne'e, no ha'u aseita termu "
"servisu."

msgid ""
"An account with this email already exists. Try logging in or resetting your "
"password."
msgstr "Konta ho email ne'e iha ona. Koko tama ka troka liafuan-pase."

msgid "Enter the restaurant's name."
msgstr "Hakerek naran restaurante."

msgid "Sign-up failed. Please try again."
msgstr "Rejistu la susesu. Favór koko fali."

msgid "Too many failed login attempts. Please try again in 15 minutes."
msgstr "Koko tama sala barak liu. Favór koko fali iha minutu 15 nia laran."

msgid "Too many sign-ups from your network. Please try again in an hour."
msgstr ""
"Rejistu barak liu husi ita-nia rede. Favór koko fali iha oras ida nia laran."

#, python-format
msgid "Welcome! We sent a confirmation link to %(email)s."
msgstr "Bemvindu! Ami haruka ona link konfirmasaun ba %(email)s."

msgid ""
"Your account is ready, but we couldn't send the confirmation email. Use "
"“Resend email” below."
msgstr ""
"Ita-nia konta prontu ona, maibé ami la konsege haruka email konfirmasaun. "
"Uza “Haruka fali email” iha okos."

msgid ""
"This confirmation link is invalid or has expired. Log in and request a new "
"one."
msgstr ""
"Link konfirmasaun ne'e la válidu ka liu ona prazu. Tama no husu link foun."

msgid ""
"Email confirmed — your restaurant is now live! Customers can scan your QR "
"codes."
msgstr ""
"Email konfirmadu ona — ita-nia restaurante ativu ona! Kliente sira bele scan "
"ita-nia kódigu QR."

msgid ""
"Email confirmed. Your restaurant is waiting for approval by the platform "
"team."
msgstr ""
"Email konfirmadu ona. Ita-nia restaurante hein hela aprovasaun husi ekipa "
"plataforma."

msgid "Email confirmed."
msgstr "Email konfirmadu ona."

msgid "Your email is already confirmed."
msgstr "Ita-nia email konfirmadu tiha ona."

msgid "Please wait a while before requesting another email."
msgstr "Favór hein uitoan molok husu email seluk."

#, python-format
msgid "Confirmation email sent to %(email)s."
msgstr "Email konfirmasaun haruka ona ba %(email)s."

msgid "We couldn't send the email right now. Please try again later."
msgstr "Ami la konsege haruka email agora. Favór koko fali depois."

msgid "Analytics page (trends, busy times, best sellers)."
msgstr "Pájina análize (tendénsia, oras okupadu, fa'an barak liu)."

msgid "Cash register: opening change and end-of-day reconciliation."
msgstr "Kaixa: troku inisiál no konfere iha loron nia rohan."

msgid "Quotations for catering and procurement bids."
msgstr "Kotasaun ba catering no konkursu públiku."

msgid "Daily expenses and profit per day, week, month and year."
msgstr "Despeza loron-loron no lukru kada loron, semana, fulan no tinan."

msgid "Several branches under one owner, with an all-branches overview."
msgstr "Filiál barak ho na'in ida, ho rezumu filiál hotu."

msgid "Ordering API for websites, apps and delivery partners."
msgstr "API orden ba website, aplikasaun no parseiru entrega."

msgid "Trial"
msgstr "Períodu esperimentál"

msgid "Active"
msgstr "Ativu"

msgid "Payment due"
msgstr "Tenke selu"

msgid "Expired"
msgstr "Liu ona prazu"

msgid "Cancelled"
msgstr "Kansela ona"

msgid "Complimentary"
msgstr "Gratuitu (oferta)"

msgid "Free plan"
msgstr "Planu gratuitu"

msgid "Open"
msgstr "Seidauk selu"

msgid "Paid"
msgstr "Selu ona"

msgid "Void"
msgstr "Anula ona"

msgid "This field is required."
msgstr "Tenke prense kampu ne'e."

msgid "Enter a valid email address."
msgstr "Hakerek enderesu email ne'ebé válidu."

msgid "Enter a whole number."
msgstr "Hakerek númeru tomak."

msgid "Enter a number."
msgstr "Hakerek númeru ida."

msgid "Enter a valid value."
msgstr "Hakerek valór ne'ebé válidu."

msgid "Enter a valid date."
msgstr "Hakerek data ne'ebé válidu."

#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Valór ne'e tenke boot liu ka hanesan %(limit_value)s."

#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Valór ne'e tenke ki'ik liu ka hanesan %(limit_value)s."

#, python-format
msgid "Select a valid choice. %(value)s is not one of the available choices."
msgstr "Hili opsaun ne'ebé válidu. %(value)s la'ós opsaun ida husi lista."

msgid "Select a valid choice. That choice is not one of the available choices."
msgstr "Hili opsaun ne'ebé válidu. Opsaun ne'e la iha lista."

msgid ""
"Upload a valid image. The file you uploaded was either not an image or a "
"corrupted image."
msgstr ""
"Tau imajen ne'ebé válidu. Arkivu ne'ebé ita tau la'ós imajen ka imajen aat."

