#, python-format
msgid "Order #%(number)s → %(status)s."
msgstr "Pedidu #%(number)s → %(status)s."

#, python-format
msgid "Payment recorded. Order #%(number)s is now %(status)s."
msgstr "Pagamentu rejista ona. Pedidu #%(number)s agora: %(status)s."

msgid "Accept"
msgstr "Simu"

msgid "Start preparing"
msgstr "Hahú prepara"

msgid "Mark ready"
msgstr "Marka prontu"

msgid "Complete"
msgstr "Remata"

msgid "Cancel order"
msgstr "Kansela pedidu"

msgid "Enter the cash received as a number, e.g. 20 or 20.00."
msgstr "Hakerek osan ne'ebé simu ho númeru, ez. 20 ka 20.00."

msgid "Enter a valid cash amount."
msgstr "Hakerek montante osan ne'ebé válidu."

#, python-format
msgid "GIVE CHANGE: %(change)s  (received %(received)s, total %(total)s)"
msgstr "FÓ TROKU: %(change)s  (simu %(received)s, totál %(total)s)"

#, python-format
msgid "Exact amount received: %(total)s. No change."
msgstr "Simu osan loos: %(total)s. La iha troku."

#, python-format
msgid "Receipt not printed: %(reason)s"
msgstr "Resibu la imprime: %(reason)s"

msgid "Cash drawer opened."
msgstr "Gaveta osan loke ona."

#, python-format
msgid "Payment saved, but the cash drawer did not open: %(reason)s"
msgstr "Pagamentu rai ona, maibé gaveta osan la loke: %(reason)s"

#, python-format
msgid "Order #%(number)s marked as paid."
msgstr "Pedidu #%(number)s marka ona katak selu ona."

msgid "Your role cannot manage tables."
msgstr "Ita-nia knaar la bele jere meza."

#, python-format
msgid "Limit reached: a restaurant can have up to %(n)s tables on your plan."
msgstr "To'o ona limite: ita-nia planu permite meza to'o %(n)s."

#, python-format
msgid "Created %(n)s table."
msgid_plural "Created %(n)s tables."
msgstr[0] "Kria ona meza %(n)s."
msgstr[1] "Kria ona meza %(n)s."

#, python-format
msgid "Limit reached: your plan allows %(n)s tables."
msgstr "To'o ona limite: ita-nia planu permite meza %(n)s."

#, python-format
msgid "Table %(number)s created."
msgstr "Meza %(number)s kria ona."

#, python-format
msgid "Guest %(n)s"
msgstr "Bainaka %(n)s"

#, python-format
msgid "Marked as paid: %(numbers)s."
msgstr "Marka ona katak selu ona: %(numbers)s."

msgid "This guest has nothing left to pay."
msgstr "Bainaka ne'e la iha buat ida atu selu tan."

msgid "There were no unpaid orders at this table."
msgstr "La iha pedidu ne'ebé seidauk selu iha meza ne'e."

#, python-format
msgid "Table %(number)s is now free."
msgstr "Meza %(number)s agora livre."

#, python-format
msgid ""
"Table %(number)s is now free. Customers must scan the QR code again to order."
msgstr ""
"Meza %(number)s agora livre. Kliente sira tenke scan fali kódigu QR atu pede."

msgid "Table updated. Reprint its QR code if you changed the number."
msgstr "Meza atualiza ona. Imprime fali kódigu QR se ita troka númeru."

#, python-format
msgid "Edit table %(number)s"
msgstr "Edita meza %(number)s"

#, python-format
msgid "Table %(number)s deleted."
msgstr "Meza %(number)s hamoos ona."

#, python-format
msgid ""
"New QR code generated for table %(number)s. Old printed codes no longer work "
"— print the new one."
msgstr ""
"Kódigu QR foun kria ona ba meza %(number)s. Kódigu tuan sira la funsiona ona "
"— imprime ida foun."

msgid "Category saved."
msgstr "Kategoria rai ona."

#, python-format
msgid "Edit category: %(name)s"
msgstr "Edita kategoria: %(name)s"

msgid "New category"
msgstr "Kategoria foun"

msgid "Category deleted."
msgstr "Kategoria hamoos ona."

msgid "Move or delete the dishes in this category first."
msgstr "Muda ka hamoos uluk hahán sira iha kategoria ne'e."

msgid "Create a category first."
msgstr "Kria uluk kategoria ida."

#, python-format
msgid "Limit reached: your plan allows %(n)s dishes."
msgstr "To'o ona limite: ita-nia planu permite hahán %(n)s."

#, python-format
msgid "“%(name)s” saved."
msgstr "“%(name)s” rai ona."

#, python-format
msgid "“%(name)s” deleted."
msgstr "“%(name)s” hamoos ona."

msgid "Restaurant settings saved."
msgstr "Konfigurasaun restaurante rai ona."

msgid "Profile"
msgstr "Perfíl"

msgid "How your restaurant appears to customers."
msgstr "Oinsá ita-nia restaurante mosu ba kliente sira."

msgid "Branding"
msgstr "Imajen"

msgid "Shown at the top of your menu. JPEG, PNG or WebP up to 5 MB."
msgstr "Mosu iha menu nia leten. JPEG, PNG ka WebP to'o 5 MB."

msgid "Ordering & money"
msgstr "Pedidu no osan"

msgid "Pause ordering at any time; prices are shown in this currency."
msgstr "Bele para pedidu iha tempu ruma; folin sira mosu iha moeda ne'e."

msgid "Customer menu language"
msgstr "Lian menu ba kliente"

msgid ""
"Customers can switch language on the menu; untranslated text falls back to "
"English."
msgstr ""
"Kliente sira bele troka lian iha menu; testu ne'ebé seidauk tradús sei mosu "
"iha Inglés."

msgid "Receipts"
msgstr "Resibu"

msgid "What happens after a payment is recorded."
msgstr "Saida mak akontese hafoin rejista pagamentu."

msgid "Receipt printer & cash drawer"
msgstr "Imprimidora resibu no gaveta osan"

msgid "Your network (ESC/POS) receipt printer. The cash drawer plugs into it."
msgstr ""
"Ita-nia imprimidora resibu iha rede (ESC/POS). Gaveta osan liga ba ne'e."

#, python-format
msgid "Limit reached: your plan allows %(n)s staff accounts."
msgstr "To'o ona limite: ita-nia planu permite konta funsionáriu %(n)s."

#, python-format
msgid "Staff account “%(username)s” created."
msgstr "Konta funsionáriu “%(username)s” kria ona."

msgid "You cannot demote or deactivate yourself."
msgstr "Ita labele hatuun ita-nia knaar rasik ka dezativa ita-an."

msgid "Staff member updated."
msgstr "Funsionáriu atualiza ona."

#, python-format
msgid "Edit %(name)s"
msgstr "Edita %(name)s"

msgid "Choose a different plan."
msgstr "Hili planu seluk."

#, python-format
msgid "Request sent: change to %(plan)s. We'll confirm shortly."
msgstr "Pedidu haruka ona: troka ba %(plan)s. Ami sei konfirma lalais."

msgid "Tables"
msgstr "Meza"

msgid "Dishes"
msgstr "Hahán"

msgid "Staff accounts"
msgstr "Konta funsionáriu"

msgid "Lower numbers appear first."
msgstr "Númeru ki'ik mosu uluk."

msgid "Hidden categories are not shown to customers."
msgstr "Kategoria subar la mosu ba kliente sira."

msgid "Untick to mark as Sold Out."
msgstr "Hasai marka atu marka Hotu ona."

msgid "Typical preparation time; leave blank to use the restaurant default."
msgstr "Tempu prepara normál; husik mamuk atu uza tempu restaurante nian."

