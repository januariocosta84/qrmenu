msgstr "Sin"

msgid "No"
msgstr "Lae"

msgid "Unknown"
msgstr "La hatene"

msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Liafuan-pase tuan sala. Favór hakerek fali."

msgid "Old password"
msgstr "Liafuan-pase tuan"

msgid "New password"
msgstr "Liafuan-pase foun"

msgid "New password confirmation"
msgstr "Konfirma liafuan-pase foun"

msgid "The two password fields didn’t match."
msgstr "Liafuan-pase rua la hanesan."

msgid "This password is too common."
msgstr "Liafuan-pase ne'e komún liu."

msgid "This password is entirely numeric."
msgstr "Liafuan-pase ne'e iha númeru de'it."

#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Liafuan-pase ne'e hanesan liu ho %(verbose_name)s."

#, python-format
msgid ""
"This password is too short. It must contain at least %(min_length)d "
"character."
msgid_plural ""
"This password is too short. It must contain at least %(min_length)d "
"characters."
msgstr[0] ""
"Liafuan-pase badak liu. Tenke iha karakter %(min_length)d pelumenus."
msgstr[1] ""
"Liafuan-pase badak liu. Tenke iha karakter %(min_length)d pelumenus."

