msgid "Restaurant name"
msgstr "Nama restoran"

msgid "Your name"
msgstr "Nama Anda"

msgid "Email"
msgstr "Email"

msgid "You'll sign in with this email. We'll send a confirmation link."
msgstr ""
"Anda akan masuk dengan email ini. Kami akan mengirim tautan konfirmasi."

msgid "Phone (optional)"
msgstr "Telepon (opsional)"

msgid "Password"
msgstr "Kata sandi"

msgid ""
"I confirm I own or manage this restaurant, and I accept the terms of service."
msgstr ""
"Saya menyatakan memiliki atau mengelola restoran ini, dan menerima ketentuan "
"layanan."

msgid ""
"An account with this email already exists. Try logging in or resetting your "
"password."
msgstr ""
"Akun dengan email ini sudah ada. Coba masuk atau atur ulang kata sandi Anda."

msgid "Enter the restaurant's name."
msgstr "Masukkan nama restoran."

msgid "Sign-up failed. Please try again."
msgstr "Pendaftaran gagal. Silakan coba lagi."

msgid "Too many failed login attempts. Please try again in 15 minutes."
msgstr ""
"Terlalu banyak percobaan masuk yang gagal. Silakan coba lagi dalam 15 menit."

msgid "Too many sign-ups from your network. Please try again in an hour."
msgstr ""
"Terlalu banyak pendaftaran dari jaringan Anda. Silakan coba lagi dalam satu "
"jam."

#, python-format
msgid "Welcome! We sent a confirmation link to %(email)s."
msgstr "Selamat datang! Kami telah mengirim tautan konfirmasi ke %(email)s."

msgid ""
"Your account is ready, but we couldn't send the confirmation email. Use "
"“Resend email” below."
msgstr ""
"Akun Anda sudah siap, tetapi kami tidak dapat mengirim email konfirmasi. "
"Gunakan “Kirim ulang email” di bawah."

msgid ""
"This confirmation link is invalid or has expired. Log in and request a new "
"one."
msgstr ""
"Tautan konfirmasi ini tidak valid atau sudah kedaluwarsa. Masuk dan minta "
"tautan baru."

msgid ""
"Email confirmed — your restaurant is now live! Customers can scan your QR "
"codes."
msgstr ""
"Email dikonfirmasi — restoran Anda sekarang aktif! Pelanggan dapat memindai "
"kode QR Anda."

msgid ""
"Email confirmed. Your restaurant is waiting for approval by the platform "
"team."
msgstr "Email dikonfirmasi. Restoran Anda menunggu persetujuan tim platform."

msgid "Email confirmed."
msgstr "Email dikonfirmasi."

msgid "Your email is already confirmed."
msgstr "Email Anda sudah dikonfirmasi."

msgid "Please wait a while before requesting another email."
msgstr "Harap tunggu sebentar sebelum meminta email lain."

#, python-format
msgid "Confirmation email sent to %(email)s."
msgstr "Email konfirmasi telah dikirim ke %(email)s."

msgid "We couldn't send the email right now. Please try again later."
msgstr "Kami tidak dapat mengirim email saat ini. Silakan coba lagi nanti."

msgid "Analytics page (trends, busy times, best sellers)."
msgstr "Halaman analitik (tren, waktu ramai, terlaris)."

msgid "Cash register: opening change and end-of-day reconciliation."
msgstr "Kas: kembalian awal dan pencocokan akhir hari."

msgid "Quotations for catering and procurement bids."
msgstr "Penawaran untuk katering dan tender pengadaan."

msgid "Daily expenses and profit per day, week, month and year."
msgstr "Pengeluaran harian dan laba per hari, minggu, bulan, dan tahun."

msgid "Several branches under one owner, with an all-branches overview."
msgstr "Beberapa cabang dengan satu pemilik, dengan ringkasan semua cabang."

msgid "Ordering API for websites, apps and delivery partners."
msgstr "API pemesanan untuk situs web, aplikasi, dan mitra pengantaran."

