msgstr "Analitik penjualan"

#: templates/storefront/home.html:123
msgid "Cash register & end-of-day reconciliation"
msgstr "Kas & pencocokan akhir hari"

#: templates/storefront/home.html:124
msgid "Quotations for catering & tenders"
msgstr "Penawaran untuk katering & tender"

#: templates/storefront/home.html:125
