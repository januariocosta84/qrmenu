msgstr "Nomor meja ini sudah ada."

msgid "From table"
msgstr "Dari meja"

msgid "To table"
msgstr "Sampai meja"

msgid "Choose a range of at most 200 tables, with end ≥ start."
msgstr "Pilih rentang maksimal 200 meja, dengan akhir ≥ awal."

msgid "Staff member"
msgstr "Staf"

msgid "Role"
msgstr "Peran"

#, python-format
msgid "Branch names must use your brand name, e.g. “%(example)s”."
msgstr "Nama cabang harus memakai nama merek Anda, mis. “%(example)s”."

msgid "Branch name"
msgstr "Nama cabang"

msgid ""
"Must use your brand name, e.g. Kafe Atauro – Comoro. Customers see this name."
msgstr ""
"Harus memakai nama merek Anda, mis. Kafe Atauro – Comoro. Pelanggan melihat "
"nama ini."

msgid "Branch address"
msgstr "Alamat cabang"

msgid "Branch phone number"
msgstr "Nomor telepon cabang"

msgid "Storefront photo"
msgstr "Foto tampak depan"

msgid "A photo of the branch from outside, showing the brand name."
msgstr "Foto cabang dari luar yang menampilkan nama merek."

msgid "Business registration number"
msgstr "Nomor registrasi usaha"

msgid ""
"All branches must belong to the same business registration as the main "
"branch."
msgstr ""
"Semua cabang harus berada di bawah registrasi usaha yang sama dengan cabang "
"utama."

msgid "Owner name"
msgstr "Nama pemilik"

msgid "Copy from"
msgstr "Salin dari"

msgid "Start empty"
msgstr "Mulai kosong"

msgid "Copy the menu (categories, dishes, photos, add-ons)"
msgstr "Salin menu (kategori, hidangan, foto, tambahan)"

msgid "Copy settings (currency, service charge, VAT, receipts, logo)"
msgstr "Salin pengaturan (mata uang, biaya layanan, PPN, struk, logo)"

msgid "Username"
msgstr "Nama pengguna"

msgid "Share it with the staff member; they can change it later."
msgstr "Bagikan kepada staf; mereka dapat mengubahnya nanti."

msgid "An account with this email already exists."
msgstr "Akun dengan email ini sudah ada."

msgid "This username is already taken."
msgstr "Nama pengguna ini sudah dipakai."

msgid "Method"
msgstr "Metode"

msgid "Amount"
msgstr "Jumlah"

msgid "Reference"
msgstr "Referensi"

msgid "Receipt / transfer reference"
msgstr "Referensi struk / transfer"

msgid "Order # / name"
msgstr "No. pesanan / nama"

msgid "Add your logo, address and opening hours"
msgstr "Tambahkan logo, alamat, dan jam buka"

msgid "Create menu categories (e.g. Rice, Drinks)"
msgstr "Buat kategori menu (mis. Nasi, Minuman)"

msgid "Add your dishes with photos and prices"
msgstr "Tambahkan hidangan dengan foto dan harga"

msgid "Create your tables"
msgstr "Buat meja Anda"

msgid "Print the QR codes and place one on each table"
msgstr "Cetak kode QR dan letakkan satu di setiap meja"

msgid "Add kitchen and waiter accounts"
msgstr "Tambahkan akun dapur dan pelayan"

#, python-format
msgid "Order #%(number)s → %(status)s."
msgstr "Pesanan #%(number)s → %(status)s."

#, python-format
msgid "Payment recorded. Order #%(number)s is now %(status)s."
msgstr "Pembayaran dicatat. Pesanan #%(number)s sekarang %(status)s."

msgid "Accept"
msgstr "Terima"

msgid "Start preparing"
msgstr "Mulai siapkan"

msgid "Mark ready"
msgstr "Tandai siap"

msgid "Complete"
msgstr "Selesaikan"

msgid "Cancel order"
msgstr "Batalkan pesanan"

msgid "Enter the cash received as a number, e.g. 20 or 20.00."
msgstr "Masukkan uang tunai yang diterima sebagai angka, mis. 20 atau 20.00."

msgid "Enter a valid cash amount."
msgstr "Masukkan jumlah tunai yang valid."

#, python-format
msgid "GIVE CHANGE: %(change)s  (received %(received)s, total %(total)s)"
msgstr "BERI KEMBALIAN: %(change)s  (diterima %(received)s, total %(total)s)"

#, python-format
msgid "Exact amount received: %(total)s. No change."
msgstr "Uang pas diterima: %(total)s. Tanpa kembalian."

#, python-format
msgid "Receipt not printed: %(reason)s"
msgstr "Struk tidak dicetak: %(reason)s"

msgid "Cash drawer opened."
msgstr "Laci kas terbuka."

#, python-format
msgid "Payment saved, but the cash drawer did not open: %(reason)s"
msgstr "Pembayaran tersimpan, tetapi laci kas tidak terbuka: %(reason)s"

msgid "Cash payment"
msgstr "Pembayaran tunai"

msgid "No sale"
msgstr "Tanpa penjualan"

msgid "Printer test"
msgstr "Uji printer"

msgid ""
"Printing a test slip. If the cash drawer is set up in the printer driver, it "
"opens too."
msgstr ""
"Mencetak slip uji. Jika laci kas sudah diatur di driver printer, laci juga "
"terbuka."

#, python-format
msgid "Cash register opened with %(amount)s change."
msgstr "Kas dibuka dengan uang kembalian %(amount)s."

msgid "Cash movement recorded."
msgstr "Pergerakan kas dicatat."

#, python-format
msgid "Order #%(number)s marked as paid."
msgstr "Pesanan #%(number)s ditandai lunas."

msgid "Your role cannot manage tables."
msgstr "Peran Anda tidak dapat mengelola meja."

#, python-format
msgid "Limit reached: a restaurant can have up to %(n)s tables on your plan."
msgstr "Batas tercapai: paket Anda mengizinkan hingga %(n)s meja."

#, python-format
msgid "Created %(n)s table."
msgid_plural "Created %(n)s tables."
msgstr[0] "%(n)s meja dibuat."

#, python-format
msgid "Limit reached: your plan allows %(n)s tables."
msgstr "Batas tercapai: paket Anda mengizinkan %(n)s meja."

#, python-format
msgid "Table %(number)s created."
msgstr "Meja %(number)s dibuat."

#, python-format
msgid "Guest %(n)s"
msgstr "Tamu %(n)s"

#, python-format
msgid "Marked as paid: %(numbers)s."
msgstr "Ditandai lunas: %(numbers)s."

msgid "This guest has nothing left to pay."
msgstr "Tamu ini tidak memiliki sisa tagihan."

msgid "There were no unpaid orders at this table."
msgstr "Tidak ada pesanan yang belum dibayar di meja ini."

#, python-format
msgid "Table %(number)s is now free."
msgstr "Meja %(number)s sekarang kosong."

#, python-format
msgid ""
"Table %(number)s is now free. Customers must scan the QR code again to order."
msgstr ""
"Meja %(number)s sekarang kosong. Pelanggan harus memindai kode QR lagi untuk "
"memesan."

msgid "Table updated. Reprint its QR code if you changed the number."
msgstr "Meja diperbarui. Cetak ulang kode QR-nya jika Anda mengubah nomornya."

#, python-format
msgid "Edit table %(number)s"
msgstr "Ubah meja %(number)s"

#, python-format
msgid "Table %(number)s deleted."
msgstr "Meja %(number)s dihapus."

#, python-format
msgid ""
"New QR code generated for table %(number)s. Old printed codes no longer work "
"— print the new one."
msgstr ""
"Kode QR baru dibuat untuk meja %(number)s. Kode lama yang tercetak tidak "
"berlaku lagi — cetak yang baru."

msgid "Category saved."
msgstr "Kategori disimpan."

#, python-format
msgid "Edit category: %(name)s"
msgstr "Ubah kategori: %(name)s"

msgid "New category"
msgstr "Kategori baru"

msgid "Category deleted."
msgstr "Kategori dihapus."

msgid "Move or delete the dishes in this category first."
msgstr "Pindahkan atau hapus dulu hidangan di kategori ini."

msgid "Create a category first."
msgstr "Buat kategori terlebih dahulu."

#, python-format
msgid "Limit reached: your plan allows %(n)s dishes."
msgstr "Batas tercapai: paket Anda mengizinkan %(n)s hidangan."

#, python-format
msgid "“%(name)s” saved."
msgstr "“%(name)s” disimpan."

#, python-format
msgid "“%(name)s” deleted."
msgstr "“%(name)s” dihapus."

msgid "Restaurant settings saved."
msgstr "Pengaturan restoran disimpan."

msgid "Profile"
msgstr "Profil"

msgid "How your restaurant appears to customers."
msgstr "Bagaimana restoran Anda tampil bagi pelanggan."

msgid "Branding"
msgstr "Branding"

msgid "Shown at the top of your menu. JPEG, PNG or WebP up to 5 MB."
msgstr "Ditampilkan di bagian atas menu. JPEG, PNG, atau WebP hingga 5 MB."

msgid "Ordering & money"
msgstr "Pesanan & uang"

msgid "Pause ordering at any time; prices are shown in this currency."
msgstr "Jeda pesanan kapan saja; harga ditampilkan dalam mata uang ini."

msgid "Tax (VAT)"
msgstr "Pajak (PPN)"

msgid ""
"Off by default. Switch it on only if your restaurant must charge VAT. Past "
"orders keep the VAT they were placed with."
msgstr ""
"Nonaktif secara bawaan. Aktifkan hanya jika restoran Anda wajib memungut "
"PPN. Pesanan lama tetap memakai PPN saat dipesan."

msgid "Customer menu language"
msgstr "Bahasa menu pelanggan"

msgid ""
"Customers can switch language on the menu; untranslated text falls back to "
"English."
msgstr ""
"Pelanggan dapat mengganti bahasa di menu; teks yang belum diterjemahkan "
"tampil dalam bahasa Inggris."

msgid "Receipts"
msgstr "Struk"

msgid "What happens after a payment is recorded."
msgstr "Apa yang terjadi setelah pembayaran dicatat."

msgid "Receipt printer & cash drawer"
msgstr "Printer struk & laci kas"

msgid ""
"Print receipts on the receipt printer of the cashier computer. A cash drawer "
"plugged into that printer opens automatically on cash payments."
msgstr ""
"Cetak struk di printer struk komputer kasir. Laci kas yang tersambung ke "
"printer itu terbuka otomatis saat pembayaran tunai."

#, python-format
msgid "Limit reached: your plan allows %(n)s staff accounts."
msgstr "Batas tercapai: paket Anda mengizinkan %(n)s akun staf."

#, python-format
msgid "%(name)s now also works at this branch."
msgstr "%(name)s kini juga bekerja di cabang ini."

#, python-format
msgid "Staff account “%(username)s” created."
msgstr "Akun staf “%(username)s” dibuat."

#, python-format
msgid ""
"Branch “%(name)s” requested. The platform team will review it; meanwhile you "
"can set up its menu and staff."
msgstr ""
"Cabang “%(name)s” diajukan. Tim platform akan meninjaunya; sementara itu "
"Anda bisa menyiapkan menu dan stafnya."

#, python-format
msgid ""
"Invoice %(number)s created for an extra branch. The slot is added as soon as "
"it is paid."
msgstr ""
"Faktur %(number)s dibuat untuk cabang tambahan. Slot ditambahkan begitu "
"dibayar."

msgid "One unused extra branch removed from your subscription."
msgstr "Satu cabang tambahan yang tidak dipakai dihapus dari langganan Anda."

msgid "Every extra branch is in use. Deactivate a branch first."
msgstr "Semua cabang tambahan sedang dipakai. Nonaktifkan satu cabang dulu."

msgid "All sources"
msgstr "Semua sumber"

msgid "Orders (QR & waiter)"
msgstr "Pesanan (QR & pelayan)"

msgid "Manual entries"
msgstr "Catatan manual"

msgid "Ordering API (all keys)"
msgstr "API pemesanan (semua kunci)"

msgid "Branch details saved."
msgstr "Detail cabang disimpan."

#, python-format
msgid ""
"%(name)s is deactivated: customers can't order and its staff can't sign in "
"to it. Its history is kept."
msgstr ""
"%(name)s dinonaktifkan: pelanggan tidak bisa memesan dan stafnya tidak bisa "
"masuk. Riwayatnya tetap disimpan."

msgid ""
"No free branch slot: all branches in your plan are in use. Add an extra "
"branch on the Branches page first."
msgstr ""
"Tidak ada slot kosong: semua cabang di paket Anda sedang dipakai. Tambahkan "
"cabang tambahan di halaman Cabang dulu."

#, python-format
msgid "%(name)s is active again."
msgstr "%(name)s aktif kembali."

msgid "Sent for review again."
msgstr "Dikirim lagi untuk ditinjau."

#, python-format
msgid "Staff account “%(username)s” created for %(branch)s."
msgstr "Akun “%(username)s” dibuat untuk %(branch)s."

#, python-format
