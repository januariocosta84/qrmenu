msgstr "Email"

msgid "You'll sign in with this email. We'll send a confirmation link."
msgstr ""
"Anda akan masuk dengan email ini. Kami akan mengirim tautan konfirmasi."

msgid "Phone (optional)"
msgstr "Telepon (opsional)"

