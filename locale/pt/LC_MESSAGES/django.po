#, python-format
msgid "Branch names must use your brand name, e.g. “%(example)s”."
msgstr ""
"Os nomes das filiais devem usar o nome da sua marca, ex.: “%(example)s”."

msgid "Branch name"
msgstr "Nome da filial"

msgid ""
"Must use your brand name, e.g. Kafe Atauro – Comoro. Customers see this name."
msgstr ""
"Deve usar o nome da sua marca, ex.: Kafe Atauro – Comoro. Os clientes veem "
"este nome."

msgid "Branch address"
msgstr "Morada da filial"

msgid "Branch phone number"
msgstr "Telefone da filial"

msgid "Storefront photo"
msgstr "Foto da fachada"

msgid "A photo of the branch from outside, showing the brand name."
msgstr "Uma foto da filial vista de fora, com o nome da marca visível."

msgid "Business registration number"
msgstr "Número de registo da empresa"

msgid ""
"All branches must belong to the same business registration as the main "
"branch."
msgstr ""
"Todas as filiais devem pertencer ao mesmo registo comercial da filial "
"principal."

msgid "Owner name"
msgstr "Nome do proprietário"

msgid "Copy from"
msgstr "Copiar de"

msgid "Start empty"
msgstr "Começar vazio"

msgid "Copy the menu (categories, dishes, photos, add-ons)"
msgstr "Copiar o menu (categorias, pratos, fotografias, extras)"

msgid "Copy settings (currency, service charge, VAT, receipts, logo)"
msgstr "Copiar definições (moeda, taxa de serviço, IVA, recibos, logótipo)"

msgid "Username"
msgstr "Nome de utilizador"

msgid "Share it with the staff member; they can change it later."
msgstr "Partilhe-a com o funcionário; poderá alterá-la depois."

msgid "An account with this email already exists."
msgstr "Já existe uma conta com este email."

msgid "This username is already taken."
msgstr "Este nome de utilizador já está a ser usado."

msgid "Method"
msgstr "Método"

msgid "Amount"
msgstr "Montante"

msgid "Reference"
msgstr "Referência"

msgid "Receipt / transfer reference"
msgstr "Referência do recibo / transferência"

msgid "Order # / name"
msgstr "N.º do pedido / nome"

msgid "Add your logo, address and opening hours"
msgstr "Adicione o logótipo, a morada e o horário"

msgid "Create menu categories (e.g. Rice, Drinks)"
msgstr "Crie categorias do menu (ex.: Arroz, Bebidas)"

msgid "Add your dishes with photos and prices"
msgstr "Adicione os pratos com fotografias e preços"

msgid "Create your tables"
msgstr "Crie as suas mesas"

msgid "Print the QR codes and place one on each table"
msgstr "Imprima os códigos QR e coloque um em cada mesa"

msgid "Add kitchen and waiter accounts"
msgstr "Adicione contas para a cozinha e os empregados"

#, python-format
msgid "Order #%(number)s → %(status)s."
msgstr "Pedido n.º %(number)s → %(status)s."

#, python-format
msgid "Payment recorded. Order #%(number)s is now %(status)s."
msgstr "Pagamento registado. O pedido n.º %(number)s está agora: %(status)s."

msgid "Accept"
msgstr "Aceitar"

msgid "Start preparing"
msgstr "Começar a preparar"

msgid "Mark ready"
msgstr "Marcar como pronto"

msgid "Complete"
msgstr "Concluir"

msgid "Cancel order"
msgstr "Cancelar pedido"

msgid "Enter the cash received as a number, e.g. 20 or 20.00."
msgstr "Introduza o dinheiro recebido como número, ex.: 20 ou 20.00."

msgid "Enter a valid cash amount."
msgstr "Introduza um montante válido."

#, python-format
msgid "GIVE CHANGE: %(change)s  (received %(received)s, total %(total)s)"
msgstr "DAR TROCO: %(change)s  (recebido %(received)s, total %(total)s)"

#, python-format
msgid "Exact amount received: %(total)s. No change."
msgstr "Valor exato recebido: %(total)s. Sem troco."

#, python-format
msgid "Receipt not printed: %(reason)s"
msgstr "Recibo não impresso: %(reason)s"

msgid "Cash drawer opened."
msgstr "Gaveta de dinheiro aberta."

#, python-format
msgid "Payment saved, but the cash drawer did not open: %(reason)s"
msgstr "Pagamento guardado, mas a gaveta não abriu: %(reason)s"

msgid "Cash payment"
msgstr "Pagamento em dinheiro"

msgid "No sale"
msgstr "Sem venda"

msgid "Printer test"
msgstr "Teste da impressora"

msgid ""
"Printing a test slip. If the cash drawer is set up in the printer driver, it "
"opens too."
msgstr ""
"A imprimir um talão de teste. Se a gaveta estiver configurada no controlador "
"da impressora, também abre."

#, python-format
msgid "Cash register opened with %(amount)s change."
msgstr "Caixa aberta com %(amount)s de troco."

msgid "Cash movement recorded."
msgstr "Movimento de dinheiro registado."

#, python-format
msgid "Order #%(number)s marked as paid."
msgstr "Pedido n.º %(number)s marcado como pago."

msgid "Your role cannot manage tables."
msgstr "A sua função não permite gerir mesas."

#, python-format
msgid "Limit reached: a restaurant can have up to %(n)s tables on your plan."
msgstr "Limite atingido: o seu plano permite até %(n)s mesas."

#, python-format
msgid "Created %(n)s table."
msgid_plural "Created %(n)s tables."
msgstr[0] "Criada %(n)s mesa."
msgstr[1] "Criadas %(n)s mesas."

#, python-format
msgid "Limit reached: your plan allows %(n)s tables."
msgstr "Limite atingido: o seu plano permite %(n)s mesas."

#, python-format
msgid "Table %(number)s created."
msgstr "Mesa %(number)s criada."

#, python-format
msgid "Guest %(n)s"
msgstr "Cliente %(n)s"

#, python-format
msgid "Marked as paid: %(numbers)s."
msgstr "Marcados como pagos: %(numbers)s."

msgid "This guest has nothing left to pay."
msgstr "Este cliente não tem nada por pagar."

msgid "There were no unpaid orders at this table."
msgstr "Não havia pedidos por pagar nesta mesa."

#, python-format
msgid "Table %(number)s is now free."
msgstr "A mesa %(number)s está agora livre."

#, python-format
msgid ""
"Table %(number)s is now free. Customers must scan the QR code again to order."
msgstr ""
"A mesa %(number)s está agora livre. Os clientes têm de ler o código QR outra "
"vez para pedir."

msgid "Table updated. Reprint its QR code if you changed the number."
msgstr "Mesa atualizada. Volte a imprimir o código QR se mudou o número."

#, python-format
msgid "Edit table %(number)s"
msgstr "Editar mesa %(number)s"

#, python-format
msgid "Table %(number)s deleted."
msgstr "Mesa %(number)s eliminada."

#, python-format
msgid ""
"New QR code generated for table %(number)s. Old printed codes no longer work "
"— print the new one."
msgstr ""
"Novo código QR gerado para a mesa %(number)s. Os códigos antigos já não "
"funcionam — imprima o novo."

msgid "Category saved."
msgstr "Categoria guardada."

#, python-format
msgid "Edit category: %(name)s"
msgstr "Editar categoria: %(name)s"

msgid "New category"
msgstr "Nova categoria"

msgid "Category deleted."
msgstr "Categoria eliminada."

msgid "Move or delete the dishes in this category first."
msgstr "Mova ou elimine primeiro os pratos desta categoria."

msgid "Create a category first."
msgstr "Crie primeiro uma categoria."

#, python-format
msgid "Limit reached: your plan allows %(n)s dishes."
msgstr "Limite atingido: o seu plano permite %(n)s pratos."

#, python-format
msgid "“%(name)s” saved."
msgstr "“%(name)s” guardado."

#, python-format
msgid "“%(name)s” deleted."
msgstr "“%(name)s” eliminado."

msgid "Restaurant settings saved."
msgstr "Definições do restaurante guardadas."

msgid "Profile"
msgstr "Perfil"

msgid "How your restaurant appears to customers."
msgstr "Como o seu restaurante aparece aos clientes."

msgid "Branding"
msgstr "Imagem"

msgid "Shown at the top of your menu. JPEG, PNG or WebP up to 5 MB."
msgstr "Aparece no topo do menu. JPEG, PNG ou WebP até 5 MB."

msgid "Ordering & money"
msgstr "Pedidos e dinheiro"

msgid "Pause ordering at any time; prices are shown in this currency."
msgstr ""
"Pause os pedidos a qualquer momento; os preços são mostrados nesta moeda."

msgid "Tax (VAT)"
msgstr "Imposto (IVA)"

msgid ""
"Off by default. Switch it on only if your restaurant must charge VAT. Past "
"orders keep the VAT they were placed with."
msgstr ""
"Desativado por defeito. Ative apenas se o seu restaurante tiver de cobrar "
"IVA. Os pedidos anteriores mantêm o IVA com que foram feitos."

msgid "Customer menu language"
msgstr "Língua do menu para clientes"

msgid ""
"Customers can switch language on the menu; untranslated text falls back to "
"English."
msgstr ""
"Os clientes podem mudar a língua no menu; o texto não traduzido aparece em "
"inglês."

msgid "Receipts"
msgstr "Recibos"

msgid "What happens after a payment is recorded."
msgstr "O que acontece depois de registar um pagamento."

msgid "Receipt printer & cash drawer"
msgstr "Impressora de recibos e gaveta de dinheiro"

msgid ""
"Print receipts on the receipt printer of the cashier computer. A cash drawer "
"plugged into that printer opens automatically on cash payments."
msgstr ""
"Imprima recibos na impressora de recibos do computador da caixa. Uma gaveta "
"ligada a essa impressora abre automaticamente nos pagamentos em dinheiro."

#, python-format
msgid "Limit reached: your plan allows %(n)s staff accounts."
msgstr "Limite atingido: o seu plano permite %(n)s contas de funcionários."

#, python-format
msgid "%(name)s now also works at this branch."
msgstr "%(name)s passa também a trabalhar nesta filial."

#, python-format
msgid "Staff account “%(username)s” created."
msgstr "Conta de funcionário “%(username)s” criada."

#, python-format
msgid ""
"Branch “%(name)s” requested. The platform team will review it; meanwhile you "
"can set up its menu and staff."
msgstr ""
"Filial “%(name)s” pedida. A equipa da plataforma vai analisá-la; entretanto "
"pode preparar o menu e a equipa."

#, python-format
msgid ""
"Invoice %(number)s created for an extra branch. The slot is added as soon as "
"it is paid."
msgstr ""
"Fatura %(number)s criada para uma filial extra. A vaga é adicionada assim "
"que for paga."

msgid "One unused extra branch removed from your subscription."
msgstr "Uma filial extra não usada foi removida da sua subscrição."

msgid "Every extra branch is in use. Deactivate a branch first."
msgstr "Todas as filiais extra estão em uso. Desative primeiro uma filial."

msgid "All sources"
msgstr "Todas as origens"

msgid "Orders (QR & waiter)"
msgstr "Pedidos (QR e empregado)"

msgid "Manual entries"
msgstr "Registos manuais"

msgid "Ordering API (all keys)"
msgstr "API de pedidos (todas as chaves)"

msgid "Branch details saved."
msgstr "Dados da filial guardados."

#, python-format
msgid ""
"%(name)s is deactivated: customers can't order and its staff can't sign in "
"to it. Its history is kept."
msgstr ""
"%(name)s está desativada: os clientes não podem pedir e a sua equipa não "
"pode entrar. O histórico é mantido."

msgid ""
"No free branch slot: all branches in your plan are in use. Add an extra "
"branch on the Branches page first."
msgstr ""
"Sem vagas livres: todas as filiais do seu plano estão em uso. Adicione "
"primeiro uma filial extra na página Filiais."

#, python-format
msgid "%(name)s is active again."
msgstr "%(name)s está ativa novamente."

msgid "Sent for review again."
msgstr "Enviada novamente para análise."

#, python-format
msgid "Staff account “%(username)s” created for %(branch)s."
msgstr "Conta “%(username)s” criada para %(branch)s."

#, python-format
msgid "Access updated for %(name)s."
msgstr "Acesso atualizado para %(name)s."

