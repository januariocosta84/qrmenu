msgid "Restaurant name"
msgstr "Nome do restaurante"

msgid "Your name"
msgstr "O seu nome"

msgid "Email"
msgstr "Email"

msgid "You'll sign in with this email. We'll send a confirmation link."
msgstr "Vai iniciar sessão com este email. Enviaremos um link de confirmação."

msgid "Phone (optional)"
msgstr "Telefone (opcional)"

msgid "Password"
msgstr "Palavra-passe"

msgid ""
"I confirm I own or manage this restaurant, and I accept the terms of service."
msgstr ""
"Confirmo que sou proprietário ou gerente deste restaurante e aceito os "
"termos de serviço."

msgid ""
"An account with this email already exists. Try logging in or resetting your "
"password."
msgstr ""
"Já existe uma conta com este email. Tente iniciar sessão ou repor a palavra-"
"passe."

msgid "Enter the restaurant's name."
msgstr "Introduza o nome do restaurante."

msgid "Sign-up failed. Please try again."
msgstr "O registo falhou. Tente novamente."

msgid "Too many failed login attempts. Please try again in 15 minutes."
msgstr "Demasiadas tentativas falhadas. Tente novamente dentro de 15 minutos."

msgid "Too many sign-ups from your network. Please try again in an hour."
msgstr ""
"Demasiados registos a partir da sua rede. Tente novamente dentro de uma hora."

#, python-format
msgid "Welcome! We sent a confirmation link to %(email)s."
msgstr "Bem-vindo! Enviámos um link de confirmação para %(email)s."

msgid ""
"Your account is ready, but we couldn't send the confirmation email. Use "
"“Resend email” below."
msgstr ""
"A sua conta está pronta, mas não foi possível enviar o email de confirmação. "
"Use “Reenviar email” abaixo."

msgid ""
"This confirmation link is invalid or has expired. Log in and request a new "
"one."
msgstr ""
"Este link de confirmação é inválido ou expirou. Inicie sessão e peça um novo."

msgid ""
"Email confirmed — your restaurant is now live! Customers can scan your QR "
"codes."
msgstr ""
"Email confirmado — o seu restaurante já está ativo! Os clientes podem ler os "
"seus códigos QR."

msgid ""
"Email confirmed. Your restaurant is waiting for approval by the platform "
"team."
msgstr ""
"Email confirmado. O seu restaurante aguarda aprovação da equipa da "
"plataforma."

msgid "Email confirmed."
msgstr "Email confirmado."

msgid "Your email is already confirmed."
msgstr "O seu email já está confirmado."

msgid "Please wait a while before requesting another email."
msgstr "Aguarde um pouco antes de pedir outro email."

#, python-format
msgid "Confirmation email sent to %(email)s."
msgstr "Email de confirmação enviado para %(email)s."

msgid "We couldn't send the email right now. Please try again later."
msgstr "Não foi possível enviar o email agora. Tente mais tarde."

msgid "Analytics page (trends, busy times, best sellers)."
msgstr "Página de análise (tendências, horas de movimento, mais vendidos)."

msgid "Cash register: opening change and end-of-day reconciliation."
msgstr "Caixa: troco inicial e conferência no fim do dia."

msgid "Quotations for catering and procurement bids."
msgstr "Cotações para catering e concursos públicos."

msgid "Daily expenses and profit per day, week, month and year."
msgstr "Despesas diárias e lucro por dia, semana, mês e ano."

msgid "Several branches under one owner, with an all-branches overview."
msgstr ""
"Várias filiais com o mesmo proprietário, com uma visão de todas as filiais."

msgid "Ordering API for websites, apps and delivery partners."
msgstr "API de pedidos para sites, apps e parceiros de entrega."

