# Copy to .env and adjust. Never commit the real .env.

# --- Core ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=menu.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://menu.example.com
TIME_ZONE=Asia/Dili

# Base URL encoded into printed table QR codes (no trailing slash).
PUBLIC_BASE_URL=https://menu.example.com

# --- Database (PostgreSQL recommended; SQLite is used if unset) ---
DATABASE_URL=postgres://qrmenu:password@127.0.0.1:5432/qrmenu

# --- Redis: required for real-time updates with more than one worker process ---
REDIS_URL=redis://127.0.0.1:6379/0

# Number of reverse proxies in front of the app (1 = Nginx). Used for client IPs / rate limits.
NUM_PROXIES=1

# --- Public platform ---
PLATFORM_NAME=QR Menu
SUPPORT_EMAIL=support@example.com
# open = live after email confirmation | approval = admin approves too | closed = no public sign-up
SIGNUP_MODE=open
# Who gets "restaurant waiting for approval" emails
PLATFORM_ADMINS=Your Name <you@example.com>
# Hide the platform admin behind a non-obvious path
ADMIN_URL=manage-7f3k2/
# Keep false on a public cloud server (see README → Cash drawer)
CASH_DRAWER_NETWORK_ENABLED=false
# MAX_TABLES_PER_RESTAURANT=300
# MAX_MENU_ITEMS_PER_RESTAURANT=500
# MAX_STAFF_PER_RESTAURANT=50
# SIGNUPS_PER_IP_PER_HOUR=5

# --- Email (required for sign-up confirmation and password reset) ---
# Example: Resend (resend.com). Verify your domain in Resend first, then use an API key as the password.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_USE_TLS=true
# If port 587 is blocked by your host: EMAIL_PORT=465 and EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=QR Menu <no-reply@timorstore.com>

# --- Optional tuning ---
# MEDIA_ROOT=/srv/qrmenu/media
# TABLE_ACCESS_HOURS=6
# THROTTLE_ORDER_CREATE=10/min
# THROTTLE_PUBLIC_READ=120/min
# DJANGO_SECURE_SSL_REDIRECT=true
# LOG_LEVEL=INFO
